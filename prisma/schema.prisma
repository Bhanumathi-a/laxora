generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id             String         @id @default(cuid())
  name           String         @unique
  users          User[]
  students       Student[]
  teachers       Teacher[]
  parents        Parent[]
  classes        Class[]
  subjects       Subject[]
  slug           String         @unique
  attendanceMode AttendanceMode @default(DAILY)
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
}

model Student {
  id            String       @id @default(cuid())
  firstName     String
  lastName      String
  gender        String
  studentId     String       @unique
  email         String
  phone         String
  address       String
  city          String
  pin           String
  state         String
  country       String
  image         String?
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  parentId      String?
  parent        Parent?      @relation(fields: [parentId], references: [id])
  classId       String
  class         Class        @relation(fields: [classId], references: [id])
  password      String
  dateOfBirth   DateTime?
  bloodGroup    String?
  previousClass String?
  admissionDate DateTime     @default(now())
  attendance    Attendance[]
}

model Attendance {
  id     String           @id @default(cuid())
  date   DateTime
  status AttendanceStatus

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

model Teacher {
  id        String @id @default(cuid())
  teacherId String @unique
  firstName String
  lastName  String
  email     String
  phone     String
  password  String

  dateOfBirth DateTime?
  bloodGroup  String?
  joiningDate DateTime  @default(now())

  subjects Subject[]
  image    String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  gender  String
  address String
  city    String
  pin     String
  state   String
  country String
}

model Parent {
  id       String    @id @default(cuid())
  name     String
  phone    String
  address  String
  city     String
  pin      String
  state    String
  country  String
  schoolId String
  school   School    @relation(fields: [schoolId], references: [id])
  students Student[]
  student  String
}

model Class {
  id       String    @id @default(cuid())
  name     String
  section  String
  capacity Int?
  schoolId String
  school   School    @relation(fields: [schoolId], references: [id])
  students Student[]
  subjects Subject[]

  @@unique([schoolId, name, section])
}

model Subject {
  id   String @id @default(cuid())
  name String

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teachers Teacher[]

  classes Class[]

  @@unique([schoolId, name])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HOLIDAY
  LEAVE
}

enum AttendanceMode {
  DAILY
  SUBJECT_WISE
}
